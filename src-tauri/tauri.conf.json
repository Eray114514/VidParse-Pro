{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "VidParse Pro",
  "version": "1.3.1",
  "identifier": "com.vidparsepro.desktop",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev:tauri",
    "beforeBuildCommand": "npm run build:tauri"
  },
  "app": {
    "windows": [
      {
        "title": "VidParse Pro",
        "width": 1100,
        "height": 660,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "zh-CN"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "externalBin": [
      "binaries/yt-dlp"
    ],
    "resources": [
      "binaries/ffmpeg.exe"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE0QUNEMEZBQjUyMUMwMUYKUldRZndDRzErdENzcEc5eWtTRGQ1cjEzaTlUSUZUd1Zha0Q0dWRWYUZnOHpLMEh0OVVDK1MxdXoK",
      "endpoints": [
        "https://vidprase.eray.top/api/updater?version={{current_version}}&target={{target}}&arch={{arch}}"
      ]
    }
  }
}
